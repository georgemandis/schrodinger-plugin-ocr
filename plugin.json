{
  "id": "ocr",
  "name": "OCR",
  "version": "0.2.0",
  "description": "Extract text from images, as plain text or as code with its indentation",
  "author": "georgemandis",
  "type": "native",
  "entry": {
    "macos-arm64": "lib/libschrodinger_plugin_ocr.dylib",
    "linux-x86_64": "lib/libschrodinger_plugin_ocr.so",
    "windows-x86_64": "lib/schrodinger_plugin_ocr.dll"
  },
  "platforms": [
    "macos",
    "windows"
  ],
  "config": {},
  "modes": [
    {
      "id": "text",
      "label": "Text",
      "default": true
    },
    {
      "id": "code",
      "label": "As code"
    }
  ]
}
